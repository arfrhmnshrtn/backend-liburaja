// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  bookings      Booking[]
  bookmarks     Bookmark[]
  voucherUsages VoucherUsage[]
}

model Package {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int
  location    String
  image       String
  createdAt   DateTime @default(now())

  bookings  Booking[]
  bookmarks Bookmark[]
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  bookingCode String?       @unique
  packageId   Int
  date        DateTime
  quantity    Int
  totalPrice  Int
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  payment      Payment?
  voucherUsage VoucherUsage?
}

model Payment {
  id         Int           @id @default(autoincrement())
  bookingId  Int           @unique
  proofImage String
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId]) //  biar tidak double bookmark
}

// enum Role {
//   USER
//   ADMIN
// }

enum BookingStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Voucher {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?

  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  // maksimal diskon jika percentage
  maxDiscount Decimal? @db.Decimal(12, 2)

  // minimal pembelian
  minPurchase Decimal? @db.Decimal(12, 2)

  quota     Int @default(0)
  usedCount Int @default(0)

  userLimit Int @default(1)

  isActive Boolean @default(true)

  startDate DateTime
  endDate   DateTime

  voucherUsages VoucherUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherUsage {
  id        String @id @default(uuid())
  voucherId String
  userId    Int
  bookingId Int    @unique

  usedAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@unique([voucherId, userId, bookingId])
}
